# Copy to .env.local for local development. Never commit a real .env file.
# Vercel dashboard: Project -> Settings -> Environment Variables.
# Values below are intentionally empty — fill them in the dashboard, not here.

# Optional. Base URL of the optional API backend (the Render health-check
# server). When empty, the store runs fully offline on the bundled
# catalogue + the visitor's own browser storage.
VITE_API_URL=

# Optional. The admin sign-in email. When empty, the admin gate is
# password-only. Set it to the store owner's Gmail to require that email
# at admin sign-in.
VITE_ADMIN_EMAIL=
